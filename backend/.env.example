# Application
APP_ENV=local
APP_NAME=SPRX Backend
SECRET_KEY=change-this-to-a-random-32-char-secret
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://sprax:sprax@localhost:5432/sprax
DATABASE_URL_SYNC=postgresql://sprax:sprax@localhost:5432/sprax

# Redis
REDIS_URL=redis://localhost:6379/0

# Sprax RPC
SPRAX_RPC_URL=http://localhost:26657
SPRAX_CHAIN_ID=sprax-testnet-1
SPRAX_DECIMALS=18

# Market Provider
MARKET_PROVIDER=coingecko
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# FX Rates Provider
FX_PROVIDER=exchangerate
FX_API_KEY=
FX_BASE_URL=https://v6.exchangerate-api.com/v6

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limits
RATE_LIMIT_PUBLIC=60/minute
RATE_LIMIT_SEARCH=30/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_WRITE=20/minute

# JWT
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Workers
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Indexer
INDEXER_POLL_INTERVAL_SECONDS=2
INDEXER_BATCH_SIZE=10

# Features (all disabled until explicitly enabled)
FEATURE_PERPS_ENABLED=false
FEATURE_MAINNET_ENABLED=false
FEATURE_PRICE_ALERTS_ENABLED=true
FEATURE_STAKING_ENABLED=true
FEATURE_MARKETS_ENABLED=true
FEATURE_DISCOVER_ENABLED=true
FEATURE_TAP_MINING_ENABLED=false

# Tap Mining (Telegram Mini App) — off-chain points, not connected to the chain
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400
TAP_MINING_WEBAPP_URL=
TAP_MINING_ENERGY_CAP=1000
TAP_MINING_ENERGY_REGEN_SECONDS=3
TAP_MINING_POINTS_PER_TAP=1
TAP_MINING_MAX_TAPS_PER_REQUEST=300
TAP_MINING_RATE_LIMIT_PER_MINUTE=20
TAP_MINING_MIN_TAP_INTERVAL_MS=200
TAP_MINING_CHECKIN_BASE_POINTS=10
TAP_MINING_CHECKIN_STREAK_BONUS=5
TAP_MINING_REFERRAL_BONUS_REFERRER=100
TAP_MINING_REFERRAL_BONUS_REFEREE=50
TAP_MINING_UPGRADE_MAX_LEVEL=10
TAP_MINING_UPGRADE_BASE_COST=500
TAP_MINING_UPGRADE_COST_MULTIPLIER=1.6
TAP_MINING_UPGRADE_ENERGY_CAP_STEP=200
TAP_MINING_UPGRADE_REGEN_STEP=1
TAP_MINING_UPGRADE_MIN_REGEN_SECONDS=1
TAP_MINING_UPGRADE_MULTITAP_STEP=1

# Hosted fiat / spot checkout gateway (see apps/mobile-wallet/docs/buy-sell.md).
# Leave empty until a provider adapter is deployed; no live trades are enabled.
TRADE_GATEWAY_URL=
TRADE_GATEWAY_TOKEN=
TRADE_CHECKOUT_HOSTS=
