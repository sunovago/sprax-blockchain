# ==============================================================================
# SPRX Protocol — Master Environment Configuration (.env.example)
# ==============================================================================

# Application Environment (development | testnet | mainnet)
APP_ENV=development
SECRET_KEY=sprax_protocol_dev_jwt_secret_key_change_in_production_min_32_bytes

# Blockchain Node JSON-RPC / REST Endpoint
SPRAX_RPC_URL=http://localhost:26657
SPRAX_CHAIN_ID=sprax-devnet-1
SPRAX_DEFAULT_FEE_ATTO=500000000000000
SPRAX_DEFAULT_GAS=200000

# Node Networking Configuration
SPRAX_P2P_PORT=26656
SPRAX_RPC_PORT=26657
SPRAX_PROMETHEUS_PORT=26660

# PostgreSQL Primary Database
DATABASE_URL=postgresql+asyncpg://sprax:sprax@localhost:5432/sprax
POSTGRES_USER=sprax
POSTGRES_PASSWORD=sprax
POSTGRES_DB=sprax
POSTGRES_PORT=5432

# Redis Cache & Message Queue
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# Indexer Configuration
INDEXER_POLL_INTERVAL_SECS=2.0
INDEXER_BATCH_SIZE=20
INDEXER_START_BLOCK=0

# Frontend & Explorer Ports
EXPLORER_UI_PORT=3001
ADMIN_PANEL_PORT=3002
WEB_WALLET_PORT=3000
